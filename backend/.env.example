# Copia este archivo a .env y rellena los valores (nunca subas .env al repositorio).

# Entorno: development | production (production exige Mongo)
APP_ENV=development

# Proveedor de base de datos: "memory" (local) o "mongodb" (Compose/prod)
DB_PROVIDER=memory

# MongoDB (solo si DB_PROVIDER=mongodb)
# Local con puerto publicado:
#   docker compose -f docker-compose.yml -f docker-compose.dev-ports.yml up -d mongodb
# URI típica (auth del contenedor):
#   mongodb://USER:PASS@localhost:27017/?authSource=admin
# Atlas (producción/demo en Render):
#   mongodb+srv://USER:PASS@cluster0.XXXXX.mongodb.net/laria_db?appName=Cluster0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=laria_db

# Credenciales de MongoDB para docker-compose (obligatorias al usar docker compose)
MONGO_USERNAME=
MONGO_PASSWORD=

# Tamaño máximo de material (bytes). 25 MiB: con Atlas M0 (512 MB en total) un
# límite de 200 MiB permitía que dos archivos llenaran el cluster.
DOCUMENT_MAX_UPLOAD_BYTES=26214400

# Dónde vive el archivo ORIGINAL (el texto extraído siempre va al blob de
# contenido, junto a los datos). `blob` = mismo almacén que el texto;
# `r2` = Cloudflare R2. Ver docs/deploy-render.md.
ORIGINAL_STORAGE=blob
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=documents/

# Redis (rate limit horizontal + caché inteligente)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
CACHE_BACKEND=memory
# CSV de IPs/CIDR del proxy que pueden fijar X-Forwarded-For
TRUSTED_PROXIES=

# Event bus: memory (sync en request) | outbox (Mongo + worker async)
EVENT_BUS_BACKEND=memory

# Proveedor de IA (solo openai)
IA_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# Curva del olvido (días de half-life)
FORGETTING_HALF_LIFE_DAYS=14
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# JWT — OBLIGATORIA: la app no arranca sin una clave de >= 32 caracteres.
# Genera una con: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: orígenes del frontend (JSON array o CSV). Sin barra final.
# Ejemplo JSON: ["https://laria-frontend.vercel.app","http://localhost:4321"]
# Ejemplo CSV:  https://laria-frontend.vercel.app,http://localhost:4321
CORS_ORIGINS=["https://laria-frontend.vercel.app","http://localhost:4321"]

# Admin inicial (opcional): se crea al arrancar si ambos campos están definidos
# Contraseña: mínimo 12 chars, mayúsculas, minúsculas y dígito
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aplicación
DEBUG=false
# Documentación Swagger/OpenAPI (desactivar en producción pública)
ENABLE_DOCS=true
# Rate limiting (desactivar solo en tests)
RATE_LIMIT_ENABLED=true
