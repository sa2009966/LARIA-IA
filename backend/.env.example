# Copia este archivo a .env y rellena los valores (nunca subas .env al repositorio).

# Entorno: development | production (production exige Mongo)
APP_ENV=development

# Proveedor de base de datos: "memory" (local) o "mongodb" (Compose/prod)
DB_PROVIDER=memory

# MongoDB (solo si DB_PROVIDER=mongodb)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=laria_db

# Credenciales de MongoDB para docker-compose (obligatorias al usar docker compose)
MONGO_USERNAME=
MONGO_PASSWORD=

# Redis (rate limit horizontal en Compose/prod)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=memory
# CSV de IPs/CIDR del proxy que pueden fijar X-Forwarded-For
TRUSTED_PROXIES=

# Event bus: memory (sync en request) | outbox (Mongo + worker async)
EVENT_BUS_BACKEND=memory

# Proveedor de IA (solo openai)
IA_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT — OBLIGATORIA: la app no arranca sin una clave de >= 32 caracteres.
# Genera una con: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: orígenes permitidos del frontend (array JSON)
CORS_ORIGINS=["http://localhost:3000"]

# Admin inicial (opcional): se crea al arrancar si ambos campos están definidos
# Contraseña: mínimo 12 chars, mayúsculas, minúsculas y dígito
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aplicación
DEBUG=false
# Documentación Swagger/OpenAPI (desactivar en producción pública)
ENABLE_DOCS=true
# Rate limiting (desactivar solo en tests)
RATE_LIMIT_ENABLED=true
