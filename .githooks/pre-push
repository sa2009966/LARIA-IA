#!/usr/bin/env bash
# Hook pre-push para el frontend LARIA (Next.js).
# Evita force-push a ramas protegidas (protege el backend/Render).
# Valida el frontend con `next build` antes de pushear a feature/frontend (Vercel auto-despliega).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PROTECTED='refs/heads/feature/backend refs/heads/develop refs/heads/main'

zero='0000000000000000000000000000000000000000'
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  for ref in $PROTECTED; do
    if [[ "$remote_ref" == "$ref" && "$remote_sha" != "$zero" ]]; then
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "pre-push: non-fast-forward a $remote_ref bloqueado." >&2
        echo "No uses git push --force a feature/backend, develop ni main." >&2
        exit 1
      fi
    fi
  done
done

# Validación del frontend solo para la rama feature/frontend
if [[ "$(git rev-parse --abbrev-ref HEAD)" == "feature/frontend" ]]; then
  echo "pre-push: validando frontend Next.js (next build)..." >&2

  if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: node no encontrado. Instala Node para validar el frontend." >&2
    exit 1
  fi

  if [[ ! -d "$ROOT/node_modules" ]]; then
    echo "pre-push: instalando dependencias..." >&2
    pnpm install --no-fund --no-audit >/dev/null 2>&1
  fi

  echo "pre-push: ejecutando next build (validación de producción)... Esto puede tardar. >&2"
  timeout 300s npx next build && echo "pre-push: build OK." >&2 || {
    echo "pre-push: ERROR en next build. Corrige antes de pushear." >&2
    exit 1
  }
fi

exit 0
