---
import "../styles/global.css";
import { LariaMark } from "../components/brand/LariaMark";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>LARIA — Tutor inteligente adaptativo</title>
    <meta
      name="description"
      content="LARIA es un tutor inteligente adaptativo: aprende de tus materiales, adapta la pedagogía a tu perfil cognitivo y guarda tu progreso."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased text-foreground">
    <main class="relative flex min-h-screen flex-col justify-center px-6 py-16 sm:px-10">
      <div class="mx-auto w-full max-w-4xl animate-brand-rise">
        <LariaMark size="hero" subtitle client:load />
        <h1 class="mt-8 max-w-2xl font-display text-3xl leading-tight text-ink sm:text-4xl md:text-5xl">
          Aprende con un tutor que se adapta a ti
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          Sube tu material, pregunta con foco conceptual y practica con quizzes.
          LARIA decide la estrategia pedagógica; el modelo solo escribe el lenguaje.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/app"
            class="inline-flex items-center justify-center rounded-lg bg-ink px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-ink/90"
          >
            Entrar
          </a>
          <a
            href="/app?view=register"
            class="inline-flex items-center justify-center rounded-lg border border-border bg-card/80 px-6 py-3 text-sm font-semibold text-ink transition hover:bg-secondary"
          >
            Registrarse
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
